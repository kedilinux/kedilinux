        <Summary>kedi-base contains required files and setup for a Kedi Linux system</Summary>
        <Description>kedi-base contains required files and setup for a Kedi Linux system. It is automatically installed on a graphical installation, but must be install manually otherwise.</Description>
	<Archive sha1sum="e333e26053f983c0e25f5497bd2bbd2deeddb566" type="targz">https://repo.kedilinux.org/src/kedi-base-5.tar.gz</Archive>
    </Source>
    <Package>
        <Name>kedi-base</Name>
        <RuntimeDependencies>
            <Dependency>tmpfiles</Dependency>
            <Dependency>kedi-keyring</Dependency>
            <Dependency>openrc</Dependency>
            <Dependency>mkinitcpio-openrc</Dependency>
            <Dependency>glibc-locales-en</Dependency>
            <Dependency>net-tools</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="config">/etc/init.d</Path>
            <Path fileType="config">/etc</Path>
            <Path fileType="data">/usr/share</Path>
        </Files>
        <Provides>
            <COMAR script="package.py">System.Package</COMAR>
        </Provides>
    </Package>
